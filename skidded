   if not CK() then return end
   local NOW = tick()
   if NOW - LAST_DETECT < 10 then
   	DETECT_COUNT += 1
   else
   	DETECT_COUNT = 1
   end
   LAST_DETECT = NOW
   if DETECT_COUNT >= 3 then
   	cW()
   	cA()
   	uC()
   	if IV() then
   		EX()
   		task.wait(1.5)
   	end
   	DETECT_COUNT = 0
   	return
   end
   if DETECT_COUNT == 2 then
   	cW()
   	cA()
   	uC()
   	if IV() then
   		EX()
   		task.wait(1)
   	end
   	local V = GV()
   	if V then
   		TV(V)
   		task.wait(0.3)
   		EV(V)
   	end
   	return
   end
   cW()
   cA()
   uC()
   task.wait(2)
end

local function MTP(T, U, VEH)
   if not getgenv().AutoFarm or IMM then return end
   if not isA() then return end
   HD()
   if not getgenv().AutoFarm then return end
   IMM = true
   cW() cA() fC() dD()
   local function A(RR)
   	if not getgenv().AutoFarm or not isA() then sAll() return end
   	HD()
   	if not getgenv().AutoFarm then sAll() return end
   	local H = VEH and GP(VEH) or getHRP()
   	if not H then sAll() return end
   	local D = Vector3.new(T.X, U and T.Y or H.Position.Y, T.Z)
   	local W = cP(H.Position, D)
   	if not W then
   		if RR > 0 then task.wait(0.05) A(RR-1)
   		else fO(H.Position, D, VEH) sAll() end
   		return
   	end
   	bV(W, VEH ~= nil)
   	local DR = false
   	for I, WP in ipairs(W) do
   		if not getgenv().AutoFarm or not isA() then sAll() return end
   		HD()
   		if not getgenv().AutoFarm then sAll() return end
   		local C = VEH and GP(VEH) or getHRP()
   		if not C then break end
   		if not VEH and not isG() then wG() if not isA() then sAll() return end end
   		local D2 = Vector2.new(C.Position.X-WP.Position.X, C.Position.Z-WP.Position.Z).Magnitude
   		if I > 1 and D2 > 10 then DR = true break end
   		local O
   		if WP.Action == Enum.PathWaypointAction.Jump then
   			local N = W[I+1]
   			O = N and fO(C.Position, N.Position, VEH) or true
   		else
   			O = sT(WP.Position, VEH and CAR_SPEED or WALK_SPEED, VEH)
   		end
   		rW(I)
   		if not O then DR = true break end
   		RunService.Heartbeat:Wait()
   	end
   	if DR then cW() cA() task.wait(0.03) A(RETRIES) return end
   	local E = VEH and GP(VEH) or getHRP()
   	if E and isA() then
   		if VEH then VEH:SetPrimaryPartCFrame(CFrame.new(T.X, E.Position.Y, T.Z))
   		else E.CFrame = CFrame.new(T.X, E.Position.Y, T.Z) end
   	end
   	sAll()
   end
   A(RETRIES)
end

local function EV(V)
   if not V then return false end
   if IV() then return true end
   local P = GP(V)
   local DP = GD(V)
   if not P then return false end
   local D = (getHRP().Position - P.Position).Magnitude
   if D > 5 then
