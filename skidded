local function FIND_ATM()
   local ATMs = Workspace:FindFirstChild("Map")
   	and Workspace.Map:FindFirstChild("Props")
   	and Workspace.Map.Props:FindFirstChild("ATMs")
   if not ATMs then return nil end
   local HRP = getHRP()
   if not HRP then return nil end
   local BEST = nil
   local BESTD = math.huge
   for _, ATM in ipairs(ATMs:GetChildren()) do
   	if ATM:IsA("Model") then
   		local dis = ATM:GetAttribute("disabled")
   		local hkr = ATM:GetAttribute("hacker")
   		if not dis and (hkr == nil or hkr == "") then
   			local PP = ATM.PrimaryPart or ATM:FindFirstChildWhichIsA("BasePart")
   			if PP then
   				local D = (PP.Position - HRP.Position).Magnitude
   				if D < BESTD then
   					BESTD = D
   					BEST = ATM
   				end
   			end
   		end
   	end
   end
   return BEST
end

local function GO_ATM_WITHDRAW(NEEDED)
   local BANK, HAND = GM()
   if HAND >= NEEDED then return true end
   local SHORT = NEEDED - HAND
   if BANK < SHORT then return false end
   local ATM = FIND_ATM()
   if not ATM then return false end
   local PP = ATM.PrimaryPart or ATM:FindFirstChildWhichIsA("BasePart")
   if not PP then return false end
   if IV() then
   	EX()
   	task.wait(0.5)
   end
   local HRP = getHRP()
   if HRP then
   	HRP.CFrame = CFrame.new(PP.Position + Vector3.new(0,0,3))
   end
   task.wait(0.5)
   local Prox = ATM:FindFirstChildWhichIsA("ProximityPrompt", true)
   if Prox then pcall(function() fireproximityprompt(Prox) end) task.wait(0.5) end
   ATM_WITHDRAW(SHORT)
   task.wait(0.3)
   local _, NEWHAND = GM()
   return NEWHAND >= NEEDED
end

local function ENSURE_HAND(NEEDED)
   local BANK, HAND = GM()
   if HAND >= NEEDED then return true end
   local TOTAL = HAND + BANK
   if TOTAL < NEEDED then return false end
   return GO_ATM_WITHDRAW(NEEDED)
end

local function HAVE_BAIT_AND_ROD()
   local B, R, _, BN, RN = GI()
   local L = GL()
   local TBI, TRI = 0, 0
   if L >= 1 and L <= 7 then TBI = 1
   elseif L >= 8 and L <= 14 then TBI = 2
   elseif L >= 15 and L <= 24 then TBI = 3
   elseif L >= 25 and L <= 29 then TBI = 4
   elseif L >= 30 and L <= 44 then TBI = 5
   elseif L >= 45 then TBI = 6 end
   if L >= 1 and L <= 19 then TRI = 1
   elseif L >= 20 and L <= 34 then TRI = 2
   elseif L >= 35 and L <= 59 then TRI = 3
   elseif L >= 60 then TRI = 4 end
   local hasBait = B ~= nil and BN ~= nil and BN >= TBI
   local hasRod = R ~= nil and RN ~= nil and RN >= TRI
   return hasBait, hasRod
end

