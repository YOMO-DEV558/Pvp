   local buyAttempts = 0
   repeat
   	buyAttempts += 1
   	if CFG.SmartBait then BB() end
   	if CFG.SmartRod then BR() end
   	task.wait(0.5)
   	readyBait, readyRod = HAVE_BAIT_AND_ROD()
   	if buyAttempts >= 5 then break end
   until readyBait and readyRod
   if not readyBait or not readyRod then return end
   equipFishingGear()
   local FP = CFG.SmartPot and SP() or nil
   local S = FP and {FP} or {Vector3.new(-84,255,180)}
   local V = GV()
   if V and not IU(V) then
   	local P = GP(V)
   	if P then
   		if (P.Position - getHRP().Position).Magnitude >= 3 then TV(V) task.wait(0.3) end
   		EV(V)
   		LK(V)
   	end
   else
   	SC()
   	task.wait(1)
   	V = GV()
   	if V then EV(V) LK(V) end
   end
   local SI = 1
   while getgenv().AutoFarm do
   	local IVeh = IV()
   	local CV = GV()
   	if not IVeh then
   		if not CV or IU(CV) then
   			SC()
   			task.wait(1)
   			CV = GV()
   		end
   		if CV then
   			local P = GP(CV)
   			if P and (P.Position - getHRP().Position).Magnitude >= 3 then TV(CV) task.wait(0.3) end
   			EV(CV)
   			LK(CV)
   		end
   		task.wait(0.5)
   		continue
   	end
   	local T = S[SI]
   	SI = (SI % #S) + 1
   	if not getgenv().AutoFarm then break end
   	if not IV() then continue end
   	local HRP = getHRP()
   	if HRP and CV and GP(CV) then
   		local PP = GP(CV)
   		PP.CFrame = CFrame.new(T)
   	end
   	task.wait(2)
   end
end

