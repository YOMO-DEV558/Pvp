local function CR(R, ...)
   if not CNT then return nil end
   if not R then return nil end
   local A = {...}
   local S, X = pcall(function()
   	if R:IsA("RemoteEvent") then
   		CNT.event += 1
   		R:FireServer(CNT.event, unpack(A))
   	elseif R:IsA("RemoteFunction") then
   		CNT.func += 1
   		return R:InvokeServer(CNT.func, unpack(A))
   	end
   end)
   if not S then return nil end
   return X
end

