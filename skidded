end

local function SC()
   local IG = lp.PlayerGui:FindFirstChild("Items")
   if not IG then return false end
   local IH = IG:FindFirstChild("ItemsHolder")
   if not IH then return false end
   local ISF = IH:FindFirstChild("ItemsScrollingFrame")
   if not ISF then return false end
   local carUUID = nil
   for _, F in ipairs(ISF:GetChildren()) do
   	if F:IsA("Frame") or F:IsA("ImageLabel") or F:IsA("ImageButton") then
   		local IT = F:GetAttribute("ItemType")
   		local IN_ = F:FindFirstChild("ItemName")
   		local NM = (IN_ and IN_:IsA("TextLabel")) and IN_.Text or ""
   		if IT == "Car" or IT == "bike" or IT == "BMX" or IT == "Vehicle" then
   			if NM:lower():find(CFG.vehicleName:lower()) or F.Name:lower():find(CFG.vehicleName:lower()) then
   				carUUID = F.Name
   				break
   			end
   		end
   	end
   end
   if not carUUID then return false end
   local broken = false
   local itemFrame = ISF:FindFirstChild(carUUID)
   if itemFrame then
   	local destroyedIcon = itemFrame:FindFirstChild("DestroyedItemIcon")
   	if destroyedIcon and destroyedIcon.Visible == true then
   		broken = true
   	end
   end
   if broken then
   	local R = ReplicatedStorage:WaitForChild("Remotes"):FindFirstChild("Get")
   	if R then
   		CR(R, "repair_vehicle", carUUID)
   		task.wait(0.5)
   	end
   end
   local RSLT = EQ(carUUID)
   if not RSLT then return false end
   for i = 1, 20 do
   	task.wait(0.3)
   	local VF = Workspace:FindFirstChild("Vehicles")
   	if VF then
   		for _, M in ipairs(VF:GetChildren()) do
   			local O = M:GetAttribute("OwnerUserId")
   			if O and O == lp.UserId then
   				return true
   			end
   		end
   	end
   end
   return false
end

