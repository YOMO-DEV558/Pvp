local function sW(P, I, T, ISCAR)
   local PT = Instance.new("Part")
   PT.Size = ISCAR and Vector3.new(2.5,0.4,2.5) or Vector3.new(1.4,0.25,1.4)
   PT.Shape = Enum.PartType.Cylinder
   PT.CFrame = CFrame.new(P) * CFrame.Angles(0,0,math.pi/2)
   PT.Anchored = true
   PT.CanCollide = false
   PT.CastShadow = false
   PT.Material = Enum.Material.Neon
   PT.Color = ISCAR and Color3.fromHSV(0.6+0.2*(I/math.max(T,1)),1,1) or Color3.fromHSV(0.33*(1-I/math.max(T,1)),1,1)
   PT.Transparency = 0.3
   PT.Parent = Workspace
   local T1 = TweenService:Create(PT, TweenInfo.new(0.55,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true), {Transparency=0.75})
   local T2 = TweenService:Create(PT, TweenInfo.new(0.75,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true), {CFrame=CFrame.new(P+Vector3.new(0,0.4,0))*CFrame.Angles(0,0,math.pi/2)})
   T1:Play() T2:Play()
   activeWaypoints[I] = {part=PT, pt=T1, ft=T2}
end

