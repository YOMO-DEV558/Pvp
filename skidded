local function isBait(itemType, itemName)
   if not itemType and not itemName then return false end
   local it = (itemType or ""):lower()
   local nm = (itemName or ""):lower()
   if it:find("bait") or it:find("ammo") then return true end
   if nm:find("wormtec") or nm:find("prawntec") or nm:find("bait") then return true end
   return false
end

local function isRod(itemType, itemName)
   if not itemType and not itemName then return false end
   local it = (itemType or ""):lower()
   local nm = (itemName or ""):lower()
   if it:find("rod") then return true end
   if nm:find("rod") or nm:find("fishing") then return true end
   return false
end

local function getBaitRank(itemName)
   if not itemName then return 0 end
   local nm = itemName:lower()
   if nm:find("ultimate") then
   	if nm:find("prawn") or nm:find("prawntec") then return 6 end
   	return 3
   end
   if nm:find("pro") then
   	if nm:find("prawn") or nm:find("prawntec") then return 5 end
   	return 2
   end
   if nm:find("regular") then
   	if nm:find("prawn") or nm:find("prawntec") then return 4 end
   	return 1
   end
   return 0
end

local function getRodRank(itemName)
   if not itemName then return 0 end
   local nm = itemName:lower()
   if nm:find("ultimate") then return 4 end
   if nm:find("advanced") then return 3 end
   if nm:find("pro") then return 2 end
   if nm:find("regular") then return 1 end
   return 0
end

local function GI()
   local IG = lp.PlayerGui:FindFirstChild("Items")
   if not IG then return nil, nil, nil, 0, 0 end
   local IH = IG:FindFirstChild("ItemsHolder")
   if not IH then return nil, nil, nil, 0, 0 end
   local ISF = IH:FindFirstChild("ItemsScrollingFrame")
   if not ISF then return nil, nil, nil, 0, 0 end

   local BAIT, ROD, CAR = nil, nil, nil
   local BAITN, RODN = 0, 0

   for _, F in ipairs(ISF:GetChildren()) do
   	if F:IsA("Frame") or F:IsA("ImageLabel") or F:IsA("ImageButton") then
   		local itemType = getItemType(F)
   		local itemName = getItemName(F)
   		local ammo = getItemAmmo(F)

   		if isBait(itemType, itemName) then
   			local rank = getBaitRank(itemName)
   			if rank > BAITN then
   				BAITN = rank
   				BAIT = F.Name
   			end
   		elseif isRod(itemType, itemName) then
   			local rank = getRodRank(itemName)
   			if rank > RODN then
   				RODN = rank
   				ROD = F.Name
   			end
   		elseif itemType == "Car" or itemType == "bike" or itemType == "BMX" or itemType == "Vehicle" then
   			CAR = F.Name
   		end
   	end
   end

   return BAIT, ROD, CAR, BAITN, RODN
end

