local function cP(F, T)
   local P = PathfindingService:CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=true,AgentCanClimb=false,WaypointSpacing=4,Costs={Water=100}})
   local O = pcall(function() P:ComputeAsync(F,T) end)
   if not O or P.Status == Enum.PathStatus.NoPath then return nil end
   return P:GetWaypoints()
end

local function mO(F, T)
   local P = RaycastParams.new()
   P.FilterDescendantsInstances = {lp.Character}
   P.FilterType = Enum.RaycastFilterType.Exclude
   local M = math.max(F.Y,T.Y)
   for I = 0, 8 do
   	local A = I/8
   	local MD = F:Lerp(T,A)
   	local U = Workspace:Raycast(MD, Vector3.new(0,80,0), P)
   	if U and MD.Y+U.Distance > M then M = MD.Y+U.Distance end
   	local D = Workspace:Raycast(MD+Vector3.new(0,80,0), Vector3.new(0,-80,0), P)
   	if D and D.Position.Y > M then M = D.Position.Y end
   end
   return M
end

local function bA(F, T, Y)
   local P = {}
   for I = 0, 18 do
   	local A = I/18
   	local X = F.X+(T.X-F.X)*A
   	local Z = F.Z+(T.Z-F.Z)*A
   	local B = F.Y+(T.Y-F.Y)*A
   	local R = B+(Y-math.max(F.Y,T.Y))*math.sin(A*math.pi)
   	table.insert(P, Vector3.new(X,R,Z))
   end
   return P
end

local function fO(F, T, VEH)
   cA()
   local P = VEH and GP(VEH) or getHRP()
   if not P then return false end
   local O = mO(F,T)
   local Y = O+7
   local AP = bA(F,T,Y)
   for I, PT in ipairs(AP) do sD(PT, I/#AP) end
   for I, PT in ipairs(AP) do
   	if not getgenv().AutoFarm or not isA() then cA() return false end
   	local N = VEH and GP(VEH) or getHRP()
   	if not N then cA() return false end
   	local S = N.Position
   	local SPD = VEH and CAR_SPEED or WALK_SPEED
   	local ST = math.max(1, math.floor((PT-S).Magnitude/(SPD/60)))
   	for J = 1, ST do
   		if not getgenv().AutoFarm or not isA() then cA() return false end
   		local NN = VEH and GP(VEH) or getHRP()
   		if not NN then cA() return false end
   		local IP = S:Lerp(PT, J/ST)
   		local L = Vector3.new(PT.X-NN.Position.X, 0, PT.Z-NN.Position.Z)
   		if L.Magnitude > 0.01 then
   			if VEH then VEH:SetPrimaryPartCFrame(CFrame.lookAt(IP, IP+L.Unit))
   			else NN.CFrame = CFrame.new(IP, IP+L.Unit) end
   		else
   			if VEH then VEH:SetPrimaryPartCFrame(CFrame.new(IP))
   			else NN.CFrame = CFrame.new(IP) end
   		end
   		RunService.Heartbeat:Wait()
   	end
   	if arcVisuals[I] and arcVisuals[I].Parent then
   		TweenService:Create(arcVisuals[I], TweenInfo.new(0.15,Enum.EasingStyle.Quad), {Transparency=1,Size=Vector3.new(0.05,0.05,0.05)}):Play()
   		Debris:AddItem(arcVisuals[I], 0.2)
   		arcVisuals[I] = nil
   	end
   end
   cA()
   return true
end

local function sT(T, SPD, VEH)
   local P = VEH and GP(VEH) or getHRP()
   if not P then return false end
   local SX, SZ = P.Position.X, P.Position.Z
   local EX_, EZ_ = T.X, T.Z
   local D = math.sqrt((EX_-SX)^2+(EZ_-SZ)^2)
   local ST = math.max(1, math.floor(D/(SPD/60)))
   local LX, LZ = EX_-SX, EZ_-SZ
   for I = 1, ST do
   	if not getgenv().AutoFarm or not isA() then return false end
   	local N = VEH and GP(VEH) or getHRP()
   	if not N then return false end
   	if not VEH and not isG() then wG() if not isA() then return false end end
   	local A = I/ST
   	local IP = Vector3.new(SX+(EX_-SX)*A, N.Position.Y, SZ+(EZ_-SZ)*A)
   	local LD = Vector3.new(LX,0,LZ)
   	if LD.Magnitude > 0.01 then
   		if VEH then VEH:SetPrimaryPartCFrame(CFrame.lookAt(IP, IP+LD.Unit))
   		else N.CFrame = CFrame.new(IP, IP+LD.Unit) end
   	else
   		if VEH then VEH:SetPrimaryPartCFrame(CFrame.new(IP))
   		else N.CFrame = CFrame.new(IP) end
   	end
   	RunService.Heartbeat:Wait()
   end
   local F = VEH and GP(VEH) or getHRP()
   if F then
   	local FP = Vector3.new(EX_, F.Position.Y, EZ_)
   	local LD = Vector3.new(LX,0,LZ)
   	if LD.Magnitude > 0.01 then
   		if VEH then VEH:SetPrimaryPartCFrame(CFrame.lookAt(FP, FP+LD.Unit))
   		else F.CFrame = CFrame.new(FP, FP+LD.Unit) end
   	else
   		if VEH then VEH:SetPrimaryPartCFrame(CFrame.new(FP))
   		else F.CFrame = CFrame.new(FP) end
   	end
   end
   return true
end

