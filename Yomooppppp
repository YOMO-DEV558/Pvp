local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua" ))()
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

-- [[ ตั้งค่าเริ่มต้น ]]
_G.SilentAimEnabled = false
_G.ShowFOV = true
_G.FOVSize = 200 -- ตั้งค่าให้เป็น 200 ทันทีที่รัน
_G.FOVColor = Color3.fromRGB(255, 255, 255)

-- สร้างวงกลม FOV
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible = _G.ShowFOV
FOVCircle.Thickness = 1.5
FOVCircle.Filled = false
FOVCircle.Color = _G.FOVColor
FOVCircle.Transparency = 1
FOVCircle.NumSides = 64

-- ฟังก์ชันอัปเดต FOV ทุกเฟรม
RunService.RenderStep:Connect(function()
    if FOVCircle then
        FOVCircle.Visible = _G.ShowFOV
        FOVCircle.Radius = _G.FOVSize
        FOVCircle.Color = _G.FOVColor
        
        local viewportSize = Camera.ViewportSize
        FOVCircle.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    end
end)

-- [[ UI Setup ]]
local Window = WindUI:CreateWindow({
    Title = "Superman Hub",
    Icon = "shield",
    Author = "by .ftgs",
    OpenButton = {
        Title = "Open Menu",
        Icon = "monitor",
        Enabled = true,
        Draggable = true,
    }
})

local Tab = Window:Tab({
    Title = "ยิง",
    Icon = "target",
})

Tab:Toggle({
    Title = "Enable Silent Aim",
    Value = _G.SilentAimEnabled,
    Callback = function(Value)
        _G.SilentAimEnabled = Value
    end
})

Tab:Section({ Title = "FOV Settings" })

Tab:Toggle({
    Title = "Show FOV Circle",
    Value = _G.ShowFOV,
    Callback = function(Value)
        _G.ShowFOV = Value
    end
})

-- แก้ไข Slider ให้ถูกต้อง (ลบวงเล็บที่เกินและปรับ Step ให้ลื่นขึ้น)
Tab:Slider({
    Title = "FOV Size",
    Step = 1,      -- ปรับทีละ 1 จะลื่นกว่ามากบนมือถือ
    Min = 10,      -- อนุญาตให้ปรับเล็กลงได้ถ้าต้องการ
    Max = 800,
    Default = _G.FOVSize, -- เริ่มต้นที่ 200 ตามที่ตั้งไว้ข้างบน
    Callback = function(Value)
        _G.FOVSize = Value
    end
})

Tab:Colorpicker({
    Title = "FOV Color",
    Default = _G.FOVColor,
    Callback = function(Value)
        _G.FOVColor = Value
    end
})
